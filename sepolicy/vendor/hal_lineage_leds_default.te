type hal_lineage_leds_default, domain;
hal_server_domain(hal_lineage_leds_default, hal_lineage_leds)

type hal_lineage_leds_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_lineage_leds_default)

binder_call(hal_lineage_leds_default, servicemanager);

# Grant access over LEDs controls
allow hal_lineage_leds_default sysfs_leds:file rw_file_perms;
allow hal_lineage_leds_default sysfs_leds:dir search;
