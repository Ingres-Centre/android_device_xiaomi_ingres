type hal_lineage_touchinjector_default, domain;
hal_server_domain(hal_lineage_touchinjector_default, hal_lineage_touchinjector)

type hal_lineage_touchinjector_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_lineage_touchinjector_default)

binder_call(hal_lineage_touchinjector_default, servicemanager);

allow hal_lineage_touchinjector_default sysfs:dir { open read };
allow hal_lineage_touchinjector_default input_device:chr_file { ioctl open read write };
allow hal_lineage_touchinjector_default input_device:dir { open read search };
allow hal_lineage_touchinjector_default uhid_device:chr_file { ioctl open read write };
