type hal_lineage_gamekeys_default, domain;
hal_server_domain(hal_lineage_gamekeys_default, hal_lineage_gamekeys)

type hal_lineage_gamekeys_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_lineage_gamekeys_default)

binder_call(hal_lineage_gamekeys_default, servicemanager);
 
allow hal_lineage_gamekeys_default input_device:chr_file { ioctl open read write };
allow hal_lineage_gamekeys_default input_device:dir { open read search };
