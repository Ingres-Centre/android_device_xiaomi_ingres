aidl_interface {
    name: "vendor.lineage.leds",
    owner: "lineage",
    vendor_available: true,
    srcs: [
        "vendor/lineage/leds/*.aidl",
    ],
    stability: "vintf",
    backend: {
        java: {
            enabled: true,
        },
        rust: {
            enabled: true,
        },
    },
    frozen: true,
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],

}
