rust_binary {
    name: "vendor.lineage.leds-service.default",
    relative_install_path: "hw",
    vendor: true,
    lints: "vendor",
    clippy_lints: "vendor",
    init_rc: ["vendor.lineage.leds-service.default.rc"],
    vintf_fragments: ["vendor.lineage.leds-service.default.xml"],
    rustlibs: [
        "libtokio",
        "librustutils",
        "liblogger",
        "liblog_rust",
        "libbinder_rs",
        "libbinder_tokio_rs",
        "vendor.lineage.leds-V1-rust"
    ],
    proc_macros: ["libasync_trait"],
    shared_libs: ["libcutils"],
    srcs: ["main.rs"],
}
