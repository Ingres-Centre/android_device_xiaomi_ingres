<compatibility-matrix version="2.0" type="framework">
    <!-- GameKeys -->
    <hal format="aidl" optional="true">
        <name>vendor.lineage.gamekeys</name>
        <version>1</version>
        <interface>
            <name>IGameKeys</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Touch Injector -->
    <hal format="aidl" optional="true">
        <name>vendor.lineage.touchinjector</name>
        <version>1</version>
        <interface>
            <name>ITouchInjector</name>
            <instance>default</instance>
        </interface>
    </hal>
</compatibility-matrix>
